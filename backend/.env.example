# =============================================================================
# MÏÏghO Backend Core - Environment Configuration Template
# =============================================================================
# Note: NEVER commit real production secrets to version control.
# Copy this file to .env for local development or inject via Secret Manager in production.

# --- SERVER CONFIGURATION ---
SERVER_MODE=development          # Options: development, production, test
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# --- CORS (Cross-Origin Resource Sharing) ---
# In production, must be explicit comma-separated list without wildcard '*'
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:8080

# --- DATABASE (PostgreSQL 16) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=miigho
DB_PASSWORD=miigho_secret
DB_NAME=miigho_dev
DB_MAX_CONNS=20
DB_SSLMODE=disable               # Use 'require' in production

# --- CACHE & RATE LIMITING (Valkey / Redis 7.2) ---
VALKEY_ADDR=localhost:6379
VALKEY_PASSWORD=
VALKEY_DB=0

# --- OBJECT STORAGE (MinIO / AWS S3 / Cloudflare R2) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=miigho-media
MINIO_USE_SSL=false              # Use 'true' for AWS S3 / Cloudflare R2

# --- EVENT BUS (NATS JetStream 2.10) ---
NATS_URL=nats://localhost:4222

# --- AUTHENTICATION & TOKENS ---
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h       # 30 days
AUTH_OTP_LENGTH=6
AUTH_OTP_MAX_ATTEMPTS=3
AUTH_OTP_TTL=5m
AUTH_JWT_SECRET=secret           # In production: must be a strong random 32+ character secret

# --- SMS GATEWAY (OTP Delivery) ---
SMS_PROVIDER=mock                # Options: mock (dev only), africas_talking, twilio, infobip
SMS_API_KEY=
SMS_SENDER_ID=MIIGHO

# --- PSP GATEWAYS (Mobile Money) ---
PSP_PROVIDER=sandbox
