# Server Configuration
PORT=8080
ENV=development
LOG_LEVEL=debug

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=miigho
DB_PASSWORD=miigho_secret
DB_NAME=miigho_dev
DB_SSLMODE=disable

# Valkey (Cache & Presence)
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=

# MinIO (Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_USE_SSL=false
MINIO_BUCKET=miigho-media

# NATS JetStream
NATS_URL=nats://localhost:4222

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_for_development_only
REFRESH_TOKEN_SECRET=super_secret_refresh_key_for_development_only

# Third-Party APIs (Placeholders)
SMS_API_KEY=test_sms_key
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
